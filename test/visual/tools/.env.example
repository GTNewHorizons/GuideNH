# ============================================================
# Visual inspection screener configuration - copy this file to .env
# and fill in a real key.
# cp .env.example .env
# (.env is excluded by .gitignore; never commit a real key)
# ============================================================

# DashScope (Alibaba Cloud Model Studio) API key - required
DASHSCOPE_API_KEY=sk-your-key

# OpenAI-compatible endpoint (the default is fine; use dashscope-intl for the
# international site)
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Vision model used for the first pass (can be overridden with --model)
# Selection measured on the Qwen platform (July 2026, recall comparison on
# known scene-entities defects):
#   qwen3-vl-flash   low end - measured to miss critical defects, unusable
#   qwen3-vl-plus    mid range - SELECTED, highest recall, false positives
#                    can be adjudicated
#   qwen-vl-max      previous flagship - lower recall than plus
# Note: the qwen2.5-vl-* series is no longer in the new platform model list.
VLM_MODEL=qwen3-vl-plus

# Concurrency (within API rate limits, default 4)
VLM_CONCURRENCY=4

# Per-call timeout in seconds
VLM_TIMEOUT=120
