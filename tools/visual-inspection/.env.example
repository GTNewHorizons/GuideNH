# ============================================================
# 视觉初筛员配置 —— 复制本文件为 .env 并填入真实密钥
# cp .env.example .env
# （.env 已被 .gitignore 排除，禁止提交真实密钥）
# ============================================================

# 阿里云百炼（DashScope）API Key —— 必填
DASHSCOPE_API_KEY=sk-在这里填入你的密钥

# OpenAI 兼容模式端点（默认即可；国际站用 dashscope-intl）
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 初筛用视觉模型（可用 --model 命令行覆盖）
# 百炼视觉模型分级参考（价格递增）：
#   qwen2.5-vl-7b-instruct    最低端 —— 便宜，小字感知存疑
#   qwen2.5-vl-32b-instruct   中端   —— 推荐起点
#   qwen2.5-vl-72b-instruct   高端
#   qwen-vl-plus-latest       商业闭源中档
#   qwen-vl-max-latest        商业闭源旗舰
VLM_MODEL=qwen2.5-vl-32b-instruct

# 并发度（API 限流内，默认 4）
VLM_CONCURRENCY=4

# 单次调用超时秒数
VLM_TIMEOUT=120
