# ============================================================
# 视觉初筛员配置 —— 复制本文件为 .env 并填入真实密钥
# cp .env.example .env
# （.env 已被 .gitignore 排除，禁止提交真实密钥）
# ============================================================

# 阿里云百炼（DashScope）API Key —— 必填
DASHSCOPE_API_KEY=sk-在这里填入你的密钥

# OpenAI 兼容模式端点（默认即可；国际站用 dashscope-intl）
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 初筛用视觉模型（可用 --model 命令行覆盖）
# 千问平台实测选型（2026-07，scene-entities 已知缺陷召回对比）：
#   qwen3-vl-flash   低端 —— 实测漏报关键缺陷，不可用
#   qwen3-vl-plus    中端 —— 【选定】召回最高，假阳可裁决
#   qwen-vl-max      旧旗舰 —— 召回低于 plus
# 注意：qwen2.5-vl-* 系列已不在新平台模型列表中
VLM_MODEL=qwen3-vl-plus

# 并发度（API 限流内，默认 4）
VLM_CONCURRENCY=4

# 单次调用超时秒数
VLM_TIMEOUT=120
